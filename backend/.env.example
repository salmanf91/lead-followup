PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lead_followup
JWT_SECRET=super-secret-jwt-key-for-phase-1-change-in-production
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost

# Super Admin Bootstrap Credentials (Used exclusively by db:seed)
SUPER_ADMIN_NAME=Super Administrator
SUPER_ADMIN_EMAIL=admin@platform.com
SUPER_ADMIN_PASSWORD=AdminPassword123!

# Google Sheets Integration (Required for automated 2-way Google Sheet Sync)
# Option A: Paste the entire downloaded service account JSON file as a single line:
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Option B: Individual Service Account credentials:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=lead-sync@your-gcp-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
